# Copia este archivo como .env.local y rellena los valores.
# En Vercel, añade las dos primeras en Settings → Environment Variables.

# Panel de administración (Sanity) — sanity.io/manage → tu proyecto
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Solo para pasar el contenido actual al panel (scripts/migrar-a-sanity.mts).
# Token con permiso "Editor". NO lo pongas en Vercel ni lo subas a GitHub.
SANITY_API_WRITE_TOKEN=

# Clave del webhook (/api/revalidar). Va en .env.local, en Vercel y en el webhook de Sanity.
SANITY_REVALIDATE_SECRET=
